name: 問真排盤
desc: 問真排盤
  # 
category: 問真
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1087.png

http:
  mitm:
    - "bzpp2.iwzbz.com"


  script:
    - match: ^https:\/\/bzpp2\.iwzbz\.com\/api\/v1\.1\/user\/getvipinfo
      name: "Wenzhen"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "Wenzhen":
    url: https://raw.githubusercontent.com/Laimeiyunzn/Js/Eight-word mantra.js
    interval: 86400