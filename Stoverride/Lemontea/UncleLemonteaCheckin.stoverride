name: "丘大叔檸檬茶自動簽到"
desc: "用於丘大叔檸檬茶，默認每天10:00自動簽到
category: 丘大叔檸檬茶
icon=https://raw.githubusercontent.com/Laimeiyunzn/Laimeiyunzn/Proxy-Mount/Stoverride/Uncle Lemontea/UncleLemontea.png
author = Laimeiyunzn
homepage= https://github.com/Laimeiyunzn/Laimeiyunzn/Proxy-Mount/Stoverride/Uncle Lemontea/Readme.md

http:

  script:

    - match: ^https?:\/\/(webapi|qmwebapi)\.qmai\.cn\/web\/(catering2-apiserver\/customer-suggest\/query-feedback-config|catering\/crm\/points-info)
      name: "UncleLemonteatoken"
      type: request
      timeout: 30
      require-body: false
      max-size: 3145728
      binary-mode: false

  mitm:
    - "qmwebapi.qmai.cn"
    - "webapi.qmai.cn"

cron:
  script:

    - name: "UncleLemontea簽到"
      cron: "00 10 * * *"
      timeout: 60

    - name: "UncleLemontea2024簽到"
      cron: "02 00 10 * * *"
      timeout: 60

script-providers:
  "UncleLemonteatoken":
    url: https://raw.githubusercontent.com/Laimeiyunzn/Laimeiyunzn/Proxy-Mount/Stoverride/UncleLemontea/UncleLemontea token.js
    interval: 86400
  "UncleLemontea簽到":
    url: https://raw.githubusercontent.com/Laimeiyunzn/Laimeiyunzn/Proxy-Mount/Stoverride/UncleLemontea/UncleLemontea.js
    interval: 86400

  "UncleLemontea2024簽到":
    url: https://raw.githubusercontent.com/Laimeiyunzn/Laimeiyunzn/Proxy-Mount/Stoverride/UncleLemontea/UncleLemontea.js
    interval: 86400