name: |-
  TikTok Unlock US Region
desc: |-
  TikTok  美國地區 解鎖
author: |-
  Semporia
icon: |-
  https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/TikTok.png
category: |-
  TikTok Unlock
openUrl: |-
  https://github.com/Semporia/TikTok-Unlock
homepage: |-
  https://github.com/Semporia/TikTok-Unlock

http:

  mitm:
    - "*.tiktokv.com"
    - "*.byteoversea.com"
    - "*.tik-tokapi.com"

  url-rewrite:
    - >-
      (?<=_region=)CN(?=&) US 307
    - >-
      (?<=&mcc_mnc=)460[0-1][0-9](?=&) 310005 307
    - >-
      ^(https?:\/\/(tnc|dm)[\w-]+\.\w+\.com\/.+)(\?)(.+) $1$3 302
    - >-
      (?<=&carrier=)[%A-Z0-9]+(?=&) Verizon 307
    - >-
      (?<=tz_name=)Asia/Shanghai(?=&) America/New_York 307
    - >-
      (?<=timezone=)8(?=&) -4 307
