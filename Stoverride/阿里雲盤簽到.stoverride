name: 阿里雲盤簽到
desc: 用於阿里雲盤每日自動簽到
category: 阿里雲盤簽到
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/bilibili.pnghttps://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Alibaba_Cloud.png
http:
  mitm:
    - "auth.alipan.com"

cron:
  # 阿里雲盤簽到
  script:
    - name: AliYunPanCheckIn
      cron: '10 0 * * *'
      timeout: 60
 
script-providers:
  AliYunPanCheckIn:
    url: https://raw.githubusercontent.com/lowking/Scripts/master/ali/aliYunPanCheckIn.js
    interval: 86400
